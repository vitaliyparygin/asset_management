<?xml version="1.0" encoding="UTF-8"?>

<odoo>


<template id="report_asset_issue_act_document">
    <t t-call="web.html_container">

        <t t-foreach="docs" t-as="o">

            <t t-call="web.external_layout">

                <div class="page"
                     style="font-family: 'DejaVu Sans', sans-serif;
                            font-size: 12px;
                            color: #222;">

                    <!-- Explicit UTF-8 declaration for PDF rendering -->
                    <meta charset="UTF-8"/>

                    <!-- Company header -->
                    <table style="width: 100%;
                                  border-collapse: collapse;
                                  margin-bottom: 25px;">
                        <tr>
                            <td style="width: 35%;
                                       vertical-align: top;
                                       border: 0;">

                                <img src="data:image/png;base64,"
                                 style="max-width: 180px; max-height: 70px;"
                                 alt="Company Logo"/>

                            </td>

                            <td style="width: 65%;
                                       vertical-align: top;
                                       text-align: right;
                                       border: 0;">

                                <div style="font-size: 18px;
                                            font-weight: bold;">
                                    <span t-field="o.company_id.name"/>
                                </div>

                                <div style="font-size: 11px;
                                            color: #666;
                                            margin-top: 5px;">
                                    Asset Management
                                </div>

                            </td>
                        </tr>
                    </table>

                    <!-- Document title -->
                    <div style="text-align: center;
                                margin-top: 20px;
                                margin-bottom: 25px;">

                        <div style="font-size: 20px;
                                    font-weight: bold;">
                            Certificate of issue of fixed assets
                        </div>

                        <div style="font-size: 12px;
                                    color: #666;
                                    margin-top: 6px;">
                            Document for transferring equipment to an employee
                        </div>

                    </div>

                    <!-- Document information -->
                    <table style="width: 100%;
                                  border-collapse: collapse;
                                  margin-bottom: 25px;">

                        <tr>
                            <td style="width: 50%;
                                       padding: 5px 0;
                                       border: 0;">

                                <strong>Asset Issue Act №:</strong>
                                <span t-esc="o.id"/>

                            </td>

                            <td style="width: 50%;
                                       padding: 5px 0;
                                       text-align: right;
                                       border: 0;">

                                <strong>Date of issue:</strong>
                                <span t-field="o.issue_date"/>

                            </td>
                        </tr>

                    </table>

                    <!-- Employee -->
                    <div style="background: #f2f2f2;
                                border: 1px solid #ccc;
                                padding: 8px 10px;
                                font-size: 14px;
                                font-weight: bold;">
                        Employee
                    </div>

                    <table style="width: 100%;
                                  border-collapse: collapse;
                                  margin-bottom: 22px;">

                        <tbody>

                            <tr>
                                <td style="width: 35%;
                                           padding: 8px 10px;
                                           border: 1px solid #ccc;
                                           font-weight: bold;">
                                    Full name
                                </td>

                                <td style="padding: 8px 10px;
                                           border: 1px solid #ccc;">
                                    <span t-field="o.employee_id.name"/>
                                </td>
                            </tr>

                            <tr t-if="o.employee_id.job_title">
                                <td style="padding: 8px 10px;
                                           border: 1px solid #ccc;
                                           font-weight: bold;">
                                    Position
                                </td>

                                <td style="padding: 8px 10px;
                                           border: 1px solid #ccc;">
                                    <span t-field="o.employee_id.job_title"/>
                                </td>
                            </tr>

                            <tr t-if="o.employee_id.department_id">
                                <td style="padding: 8px 10px;
                                           border: 1px solid #ccc;
                                           font-weight: bold;">
                                    Відділ
                                </td>

                                <td style="padding: 8px 10px;
                                           border: 1px solid #ccc;">
                                    <span t-field="o.employee_id.department_id.name"/>
                                </td>
                            </tr>

                        </tbody>

                    </table>

                    <!-- Equipment -->
                    <div style="background: #f2f2f2;
                                border: 1px solid #ccc;
                                padding: 8px 10px;
                                font-size: 14px;
                                font-weight: bold;">
                        Equipment
                    </div>

                    <table style="width: 100%;
                                  border-collapse: collapse;
                                  margin-bottom: 22px;">

                        <tbody>

                            <tr>
                                <td style="width: 35%;
                                           padding: 8px 10px;
                                           border: 1px solid #ccc;
                                           font-weight: bold;">
                                    Name
                                </td>

                                <td style="padding: 8px 10px;
                                           border: 1px solid #ccc;">
                                    <span t-field="o.asset_id.name"/>
                                </td>
                            </tr>

                            <tr>
                                <td style="padding: 8px 10px;
                                           border: 1px solid #ccc;
                                           font-weight: bold;">
                                    Equipment type
                                </td>

                                <td style="padding: 8px 10px;
                                           border: 1px solid #ccc;">
                                    <span t-field="o.asset_type_id.name"/>
                                </td>
                            </tr>

                            <tr t-if="o.asset_id.serial_number">
                                <td style="padding: 8px 10px;
                                           border: 1px solid #ccc;
                                           font-weight: bold;">
                                    Serial number
                                </td>

                                <td style="padding: 8px 10px;
                                           border: 1px solid #ccc;">
                                    <span t-field="o.asset_id.serial_number"/>
                                </td>
                            </tr>

                            <tr t-if="o.asset_id.inventory_number">
                                <td style="padding: 8px 10px;
                                           border: 1px solid #ccc;
                                           font-weight: bold;">
                                    Inventory number
                                </td>

                                <td style="padding: 8px 10px;
                                           border: 1px solid #ccc;">
                                    <span t-field="o.asset_id.inventory_number"/>
                                </td>
                            </tr>

                            <tr>
                                <td style="padding: 8px 10px;
                                           border: 1px solid #ccc;
                                           font-weight: bold;">
                                    Date of issue
                                </td>

                                <td style="padding: 8px 10px;
                                           border: 1px solid #ccc;">
                                    <span t-field="o.issue_date"/>
                                </td>
                            </tr>

                            <tr t-if="o.return_date">
                                <td style="padding: 8px 10px;
                                           border: 1px solid #ccc;
                                           font-weight: bold;">
                                    Return date
                                </td>

                                <td style="padding: 8px 10px;
                                           border: 1px solid #ccc;">
                                    <span t-field="o.return_date"/>
                                </td>
                            </tr>

                        </tbody>

                    </table>

                    <!-- Notes -->
                    <div t-if="o.notes"
                         style="margin-bottom: 25px;">

                        <div style="background: #f2f2f2;
                                    border: 1px solid #ccc;
                                    padding: 8px 10px;
                                    font-size: 14px;
                                    font-weight: bold;">
                            Notes
                        </div>

                        <div style="border: 1px solid #ccc;
                                    border-top: 0;
                                    padding: 10px;
                                    min-height: 40px;">
                            <span t-field="o.notes"/>
                        </div>

                    </div>

                    <!-- Responsibility statement -->
                    <div style="margin-top: 25px;
                                margin-bottom: 40px;
                                line-height: 1.6;
                                text-align: justify;">

                        <p>
                            The equipment specified in this act has been transferred to the employee for the performance of official duties. The employee confirms receipt of the equipment and assumes responsibility for its proper use and storage.
                        </p>

                    </div>

                    <!-- Signatures -->
                    <table style="width: 100%;
                                  border-collapse: collapse;
                                  margin-top: 45px;">

                        <tr>

                            <td style="width: 50%;
                                       padding-right: 30px;
                                       border: 0;
                                       vertical-align: top;">

                                <div style="font-weight: bold;
                                            margin-bottom: 30px;">
                                    Employee
                                </div>

                                <div style="height: 25px;
                                            border-bottom: 1px solid #333;">
                                </div>

                                <div style="font-size: 10px;
                                            color: #777;
                                            margin-top: 5px;">
                                    Signature
                                </div>

                                <div style="margin-top: 12px;">
                                    <span t-field="o.employee_id.name"/>
                                </div>

                            </td>

                            <td style="width: 50%;
                                       padding-left: 30px;
                                       border: 0;
                                       vertical-align: top;">

                                <div style="font-weight: bold;
                                            margin-bottom: 30px;">
                                    Responsible person
                                </div>

                                <div style="height: 25px;
                                            border-bottom: 1px solid #333;">
                                </div>

                                <div style="font-size: 10px;
                                            color: #777;
                                            margin-top: 5px;">
                                    Signature
                                </div>

                                <div style="margin-top: 12px;">
                                    &#160;
                                </div>

                            </td>

                        </tr>

                    </table>

                    <!-- Footer -->
                    <div style="margin-top: 45px;
                                padding-top: 8px;
                                border-top: 1px solid #ccc;
                                font-size: 9px;
                                color: #777;
                                text-align: center;">

                        <span t-field="o.company_id.name"/>
                        <span> — Asset Management</span>

                    </div>

                </div>

            </t>

        </t>

    </t>
</template>


</odoo>
