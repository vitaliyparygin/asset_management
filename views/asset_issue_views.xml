<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_asset_management_issue_list" model="ir.ui.view">
        <field name="name">asset.management.issue.list</field>
        <field name="model">asset.management.issue</field>
        <field name="arch" type="xml">
            <list string="Issue History" default_order="issue_date desc"
                  decoration-info="state == 'issued'">
                <field name="asset_id"/>
                <field name="asset_type_id"/>
                <field name="employee_id"/>
                <field name="issue_date"/>
                <field name="return_date"/>
                <field name="duration_days"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'issued'"
                       decoration-success="state == 'returned'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_asset_management_issue_kanban" model="ir.ui.view">
        <field name="name">asset.management.issue.kanban</field>
        <field name="model">asset.management.issue</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column">
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="d-flex justify-content-between">
                                <strong><field name="asset_id"/></strong>
                                <field name="state" widget="badge"
                                       decoration-info="state == 'issued'"
                                       decoration-success="state == 'returned'"/>
                            </div>
                            <div class="text-muted">
                                <field name="asset_type_id"/>
                            </div>
                            <div>
                                <i class="fa fa-user me-1" title="Employee"/><field name="employee_id"/>
                            </div>
                            <div class="d-flex justify-content-between text-muted">
                                <span>
                                    <i class="fa fa-calendar me-1" title="Issue dates"/>
                                    <field name="issue_date"/>
                                    <t t-if="record.return_date.raw_value">
                                        &#8594; <field name="return_date"/>
                                    </t>
                                </span>
                                <span>
                                    <field name="duration_days"/> d.
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_asset_management_issue_form" model="ir.ui.view">
        <field name="name">asset.management.issue.form</field>
        <field name="model">asset.management.issue</field>
        <field name="arch" type="xml">
            <form string="Issue History">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="issued,returned"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="asset_id"/>
                            <field name="asset_type_id" readonly="1"/>
                            <field name="employee_id"
                                   domain="[('company_id', '=', company_id)]"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="issue_date"/>
                            <field name="return_date"/>
                            <field name="duration_days"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_asset_management_issue" model="ir.actions.act_window">
        <field name="name">Issue History</field>
        <field name="res_model">asset.management.issue</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No issue records yet
            </p>
            <p>
                Use the "Issue" button on an asset to create the first
                record here.
            </p>
        </field>
    </record>

</odoo>
