<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_asset_management" model="ir.module.category">
        <field name="name">Asset Management</field>
        <field name="description">Company equipment issue tracking</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_asset_user" model="res.groups">
        <field name="name">Asset User</field>
        <field name="category_id" ref="module_category_asset_management"/>
        <field name="comment">
            Can view equipment and its issue history, and issue/return
            equipment through the standard workflow buttons. Cannot create
            or edit equipment records or types directly.
        </field>
    </record>

    <record id="group_asset_manager" model="res.groups">
        <field name="name">Asset Manager</field>
        <field name="category_id" ref="module_category_asset_management"/>
        <field name="implied_ids" eval="[Command.link(ref('group_asset_user'))]"/>
        <field name="comment">
            Full access: create/edit equipment and equipment types, manage
            the issue history, and administer the module.
        </field>
    </record>

    <record id="base.user_admin" model="res.users">
        <field name="groups_id" eval="[Command.link(ref('group_asset_manager'))]"/>
    </record>

    <!-- Multi-company record rules -->
    <record id="asset_management_asset_comp_rule" model="ir.rule">
        <field name="name">Asset Management Asset: multi-company</field>
        <field name="model_id" ref="model_asset_management_asset"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="asset_management_issue_comp_rule" model="ir.rule">
        <field name="name">Asset Management Issue: multi-company</field>
        <field name="model_id" ref="model_asset_management_issue"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
