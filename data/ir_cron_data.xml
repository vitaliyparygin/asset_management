<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!--
        days_issued is a stored computed field that depends on the current
        date ("today"), which is not itself a trigger Odoo can watch. It
        therefore only recomputes on the next write to a currently-issued
        asset. This daily cron keeps it accurate for reporting/display even
        on days with no other activity. Note that the "Issued < 7 days" /
        "Issued > 30 days" search filters do NOT depend on this field - they
        compare issue_date directly against context_today(), so they are
        always correct even between cron runs (see views/asset_search_views.xml).
    -->
    <record id="ir_cron_refresh_date_dependent_fields" model="ir.cron">
        <field name="name">Asset Management: Refresh Date-Dependent Fields</field>
        <field name="model_id" ref="model_asset_management_asset"/>
        <field name="state">code</field>
        <field name="code">model._cron_refresh_date_dependent_fields()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

</odoo>
